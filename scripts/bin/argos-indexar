#!/opt/argos-ia/venv/bin/python
"""argos-indexar: indexa la boveda (.md) por encabezados con embeddings locales (Ollama bge-m3). Incremental por hash. Sin servicios externos."""
import os, re, sys, json, time, sqlite3, hashlib, urllib.request
import numpy as np
V = os.environ.get("ARGOS_VAULT", "<RUTA_BOVEDA>")
DB = os.environ.get("ARGOS_BUSQUEDA_DB", "/opt/argos-data/busqueda/index.db")
MODEL = os.environ.get("ARGOS_EMBED_MODEL", "bge-m3")
OLLAMA = "http://127.0.0.1:11434"
LOGF = "/var/log/argos/busqueda.log"; STATUS = "/var/lib/argos/busqueda-status"
MAXC = 1800; MINC = 200   # caracteres (~450 / ~50 tokens)
def log(m):
    print(m)
    try: open(LOGF, "a").write(time.strftime("%Y-%m-%dT%H:%M:%S%z ") + m + "\n")
    except OSError: pass
def embed(texts):
    out = []
    for i in range(0, len(texts), 16):
        req = urllib.request.Request(OLLAMA + "/api/embed", json.dumps({"model": MODEL, "input": texts[i:i+16], "keep_alive": "2m"}).encode(), {"Content-Type": "application/json"})
        out += json.load(urllib.request.urlopen(req, timeout=600))["embeddings"]
    a = np.array(out, dtype=np.float32); a /= np.linalg.norm(a, axis=1, keepdims=True) + 1e-9
    return a
def chunks(path, s):
    fm = {}
    m = re.match(r"---\n(.*?)\n---\n", s, re.S)
    if m:
        for l in m.group(1).splitlines():
            if ":" in l: k, v = l.split(":", 1); fm[k.strip()] = v.strip().strip('"')
        s = s[m.end():]
    s = re.sub(r"<!-- nav:inicio.*?<!-- nav:fin -->", "", s, flags=re.S)
    s = re.sub(r"<!--.*?-->", "", s, flags=re.S)
    s = re.sub(r"^> ↑ .*$", "", s, flags=re.M)
    title = os.path.basename(path)[:-3]
    secs, cur, head = [], [], title
    for line in s.splitlines():
        h = re.match(r"(#{1,4})\s+(.*)", line)
        if h:
            if "".join(cur).strip(): secs.append((head, "\n".join(cur).strip()))
            head = h.group(2).strip() if h.group(2).strip() != title else title; cur = []
        else: cur.append(line)
    if "".join(cur).strip(): secs.append((head, "\n".join(cur).strip()))
    out = []
    for head, txt in secs:
        txt = re.sub(r"\n{3,}", "\n\n", txt)
        if out and len(txt) < MINC and len(out[-1][1]) + len(txt) < MAXC and out[-1][0].split(" › ")[0] == head.split(" › ")[0]:
            out[-1] = (out[-1][0], out[-1][1] + "\n\n### " + head + "\n" + txt); continue
        while len(txt) > MAXC:
            cut = txt.rfind("\n", 0, MAXC); cut = cut if cut > MAXC // 2 else MAXC
            out.append((head, txt[:cut])); txt = txt[cut:].lstrip()
        if txt.strip(): out.append((head, txt))
    return fm, [(h, t) for h, t in out if len(t.strip()) > 20]
def main():
    t0 = time.time(); os.makedirs(os.path.dirname(DB), exist_ok=True)
    db = sqlite3.connect(DB)
    db.executescript("""create table if not exists files(path text primary key, sha text, model text);
    create table if not exists chunks(id integer primary key, path text, heading text, ramo text, carpeta text, tipo text, unidad text, text text, vec blob);
    create virtual table if not exists fts using fts5(text, heading, path, content='chunks', content_rowid='id', tokenize='unicode61 remove_diacritics 2');""")
    old = dict(db.execute("select path, sha||'|'||model from files"))
    seen = set(); nuevos = chunks_n = 0
    for root, dirs, files in os.walk(V):
        dirs[:] = [d for d in dirs if not d.startswith(".")]
        for f in files:
            if not f.endswith(".md"): continue
            p = os.path.join(root, f); rel = os.path.relpath(p, V); seen.add(rel)
            raw = open(p, "rb").read(); h = hashlib.sha256(raw).hexdigest()
            if old.get(rel) == h + "|" + MODEL: continue
            fm, cs = chunks(rel, raw.decode("utf8", "replace"))
            parts = rel.split(os.sep); carpeta = parts[1] if parts[0] == "Ramos" and len(parts) > 2 else ""
            vecs = embed([f"{os.path.basename(rel)[:-3]} — {hd}\n{t}" for hd, t in cs]) if cs else []
            ids = [r[0] for r in db.execute("select id from chunks where path=?", (rel,))]
            for i in ids: db.execute("insert into fts(fts, rowid, text, heading, path) select 'delete', id, text, heading, path from chunks where id=?", (i,))
            db.execute("delete from chunks where path=?", (rel,))
            for (hd, t), v in zip(cs, vecs):
                cur = db.execute("insert into chunks(path,heading,ramo,carpeta,tipo,unidad,text,vec) values(?,?,?,?,?,?,?,?)",
                                 (rel, hd, fm.get("ramo", ""), carpeta, fm.get("tipo", ""), fm.get("unidad", ""), t, v.tobytes()))
                db.execute("insert into fts(rowid,text,heading,path) values(?,?,?,?)", (cur.lastrowid, t, hd, rel))
            db.execute("insert or replace into files values(?,?,?)", (rel, h, MODEL)); db.commit()
            nuevos += 1; chunks_n += len(cs); log(f"INDEXADO {rel} ({len(cs)} fragmentos)")
    borr = [p for p in old if p not in seen]
    for p in borr:
        db.execute("insert into fts(fts, rowid, text, heading, path) select 'delete', id, text, heading, path from chunks where path=?", (p,))
        db.execute("delete from chunks where path=?", (p,)); db.execute("delete from files where path=?", (p,)); log(f"BORRADO {p}")
    db.commit()
    tot = db.execute("select count(*) from chunks").fetchone()[0]; nf = db.execute("select count(*) from files").fetchone()[0]
    st = f"OK {time.strftime('%Y-%m-%dT%H:%M:%S%z')} archivos={nf} fragmentos={tot} reindexados={nuevos} borrados={len(borr)} seg={time.time()-t0:.1f} modelo={MODEL}\n"
    try: open(STATUS, "w").write(st)
    except OSError as e: print("aviso status:", e, file=sys.stderr)
    print(st.strip())
try: main()
except Exception as e:
    msg = f"FAIL {time.strftime('%Y-%m-%dT%H:%M:%S%z')} {type(e).__name__}: {e}"
    log(msg)
    try: open(STATUS, "w").write(msg + "\n")
    except OSError: pass
    sys.exit(1)
