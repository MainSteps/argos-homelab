#!/usr/bin/env python3
"""argos-mapa: regenera _Sistema/Mapa.md (arbol + descripcion de una linea por nota). Sin IA."""
import os, re, time
V = os.environ.get("ARGOS_VAULT", "<RUTA_BOVEDA>")
OUT = os.path.join(V, "_Sistema", "Mapa.md")
def desc(p):
    s = open(p, encoding="utf8").read()
    fm = {}
    m = re.match(r"---\n(.*?)\n---\n", s, re.S)
    if m:
        for l in m.group(1).splitlines():
            if ":" in l: k, v = l.split(":", 1); fm[k.strip()] = v.strip()
        s = s[m.end():]
    ia = re.search(r"## Resumen para IA\n\n- (.+)", s)
    if ia: line = ia.group(1)
    else:
        line = ""
        for l in s.splitlines():
            l = l.strip()
            if not l or l.startswith(("> ↑", "<!--", "#", "|", "---", "```", "![[")): continue
            line = l.lstrip(">-* ").strip(); break
    line = re.sub(r"\[\[([^\]|]+\|)?([^\]]+)\]\]", r"\2", line)
    line = re.sub(r"[*_`]", "", line)
    t = fm.get("tipo", "?")
    return t, (line[:110] + "…") if len(line) > 110 else line, len(s)
out = ["---\ntipo: sistema\n---\n> ↑ Inicio: [[00 Inicio]] · Reglas: [[Instrucciones]]\n",
       f"# Mapa de la bóveda\n\nGenerado por argos-mapa ({time.strftime('%Y-%m-%d %H:%M')}). Formato: `nota [tipo, ~tokens] descripción`. Material/ y PDFs se omiten salvo conteo.\n"]
for root, dirs, files in os.walk(V):
    dirs[:] = sorted(d for d in dirs if not d.startswith("."))
    rel = os.path.relpath(root, V)
    if rel.startswith("_Sistema"): continue
    depth = 0 if rel == "." else rel.count(os.sep) + 1
    mds = sorted(f for f in files if f.endswith(".md"))
    other = [f for f in files if not f.endswith(".md")]
    if rel != ".": out.append(f"\n{'#' * min(depth + 1, 6)} {os.path.basename(root)}\n")
    if "Material" in rel.split(os.sep):
        out.append(f"- {len(mds)} notas convertidas (crudas, abrir al final)\n"); continue
    for f in sorted(mds, key=lambda x: (not x.startswith("_"), x)):
        t, d, n = desc(os.path.join(root, f))
        out.append(f"- [[{f[:-3]}]] [{t}, ~{n // 4}] {d}\n")
    if other: out.append(f"- ({len(other)} adjuntos/PDF)\n")
tmp = OUT + ".tmp"; open(tmp, "w", encoding="utf8").write("".join(out)); os.replace(tmp, OUT)
print("mapa:", OUT)
